{
  "manifest_version": 3,
  "name": "GustavIA - Asistente de Reuniones",
  "version": "2.0",
  "description": "Captura el audio de cualquier pestaña de reunión y genera un resumen inteligente de forma invisible.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
